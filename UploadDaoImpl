		logger.info("UploadDocumentsSql: " + uploadDocumentsSql);
		try {
			String documentList = Optional.ofNullable(uploadResult.documentList())
				    .orElse(Collections.emptyList())
				    .stream()
				    .map(Object::toString)
				    .collect(Collectors.joining(","));

			logger.info("Uploaded document List: " + documentList);
			int a=jdbcTemplate.update(uploadDocumentsSql, customer.cif(),
					customer.branchCode(),
					customer.accountNumber(),
					uploadResult.channel(),
					String.valueOf(uploadResult.documentsUploaded()),
					documentList, 
					uploadResult.code(),
					uploadResult.message());
			logger.info(" No of rows inserted = "+a);
		}catch(Exception e) {
			logger.error("Error inserting entries in UploadDocumentsSql ",e);
		}
	}

