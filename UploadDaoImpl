	@Override
	public List<CustomerRecord> fetchPendingCustomers(String category, String lcpcName, int batchSizePerLcpc) {

		//String fetchCustomerQuery= "select cif_number, Account_number,branch_code,lcpc,categary from kycupdate.kyc_perfios_customer_details where lcpc=? and categary=? and rownum<?";
		logger.info("fetchCustomerQuery : "+fetchCustomerQuery);
		try {
			return jdbcTemplate.query(fetchCustomerQuery, new RowMapper<CustomerRecord>() {
				@Override
				public CustomerRecord mapRow(ResultSet rs, int rowNum) throws SQLException {
					return new CustomerRecord(
							rs.getString("cif_number"), 
							rs.getString("branch_code"), 
							rs.getString("account_number"), 
							rs.getString("lcpc"), 
							rs.getString("categary")
							);
				}
			}, lcpcName, category, batchSizePerLcpc);
		}catch(Exception e) {
			logger.info("Exception e : ",e);
			return Collections.emptyList();
		}
	}

	@Override
	public boolean getCustomerStatus(String cif, String branchCode, String accountNumber) {
		String status="";

		//String ckycCustomerQuery="select status from ckyc.ckyc_customer_details where cif_number =?"; //null/IP/SB/USB/S/SS/ASB/AUSB
		logger.info("ckycCustomerQuery : "+ckycCustomerQuery);
		try {
			if(jdbcTemplate==null) logger.info("jdbcTemplate is null");
			status=jdbcTemplate.queryForObject(ckycCustomerQuery, String.class,cif);
		}catch(EmptyResultDataAccessException e) {
			logger.error("Exception : ",e.getMessage());
			status="";
		}catch(Exception e) {
			logger.error("Exception : ",e);
			status="";
		}

		List<String> ckycStatusList=Arrays.asList(ckycStatusSet.split(","));

		if(status==null||status.isEmpty()||ckycStatusList.contains(status)){

			List<String> kycStatusList=Arrays.asList(kycStatusSet.split(","));

		//	String kycCustomerQuery="select status from kycupdate.kyc_customer_details where cif_number =?";//null/KIP/KSB/KUSB/KS/KSS/S/SS
			logger.info("kycCustomerQuery : "+kycCustomerQuery);
			try {
				status=jdbcTemplate.queryForObject(kycCustomerQuery, String.class,cif);
			}catch(EmptyResultDataAccessException e) {
				logger.error("Exception : ",e.getMessage());
				status="";
			}catch(Exception e) {
				logger.error("Exception : ",e);;
			}
			return (status==null||status.isEmpty()||kycStatusList.contains(status))?true:false;
		}
		return false;
	}

	@Override
	public Map<String, FileParameters> fetchValidations() {
	//	String fileValidationSql = "SELECT * FROM kycupdate.kyc_perfios_validation";
		logger.info("query to fetch validations: "+fileValidationSql);
		try {
			Map<String, FileParameters> userMap = jdbcTemplate.query(fileValidationSql, new ResultSetExtractor<Map<String, FileParameters>>() {
				@Override
				public Map<String, FileParameters> extractData(ResultSet rs)  {
					Map<String, FileParameters> map = new HashMap<>();
					try {
						logger.info("resultSet  "+rs);

						while (rs.next()) {
							BeanPropertyRowMapper<FileParameters> mapper = new BeanPropertyRowMapper<>(FileParameters.class);
							FileParameters bean = mapper.mapRow(rs, rs.getRow());
							logger.info("FileParameters :  "+bean.toString());
							map.put(bean.getFileType(), bean);
						}
					} catch (SQLException e) {
						logger.info("Exception   "+e.getMessage());
					}
					return map;
				}
			});
			logger.info("validations fetched  ");
			return userMap;
		}catch(EmptyResultDataAccessException e) {
			logger.error("EmptyResultDataAccessException : ",e);
			return Collections.emptyMap();
		}catch(Exception e) {
			logger.error("Exception : ",e);
			return Collections.emptyMap();
		}
	}

	@Override
