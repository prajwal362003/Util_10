		logger.info("EDMS upload Response: " + uploadResponse);

		logger.info("<<<<<<Step 4 Response>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>");

		// 7. Decrypt and Parse Final Response
		String decryptedResponse2 = ClientUtility.decryptResponse(uploadResponse, privateKey);
