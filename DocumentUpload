	/**
	 * Helper method to handle HTTP POST requests using Java 11+ HttpClient
	 */
	private String sendPostRequest(String body, String tokenHeader) throws Exception {
		logger.info("Kycupdate Upload API url >>>>>>>>>>: " + props.getUrl());
		HttpRequest request = HttpRequest.newBuilder()
				.uri(URI.create(props.getUrl()))
				.header("Content-Type", "application/json")
				.header("signedSenderTokenHash", tokenHeader)
				.POST(HttpRequest.BodyPublishers.ofString(body))
				.build();

		HttpResponse<String> response =null;
		try {
			response = httpClient.send(request, HttpResponse.BodyHandlers.ofString());
			logger.info("response : " + response);
		}catch(Exception e) {
			e.printStackTrace();
			logger.error("Error : ",e);
			logger.error("Unable to connect to the server. Status: " + response+". | "+e.getMessage());
			throw new RuntimeException("Server connection failed with status: " + response.statusCode());
		}

		if (response.statusCode() != 200) {
			logger.info("Unable to connect to the server. Status: " + response.statusCode());
			throw new RuntimeException("Server connection failed with status: " + response.statusCode());
		}
		logger.info("response body : " + response.body());
		return response.body();
	}

	/**
	 * Generates a cryptographically secure random numeric string.
	 * Replaces Apache Commons RandomStringUtils.
	 */
	private String generateSecureNumericId(int length) {
		SecureRandom secureRandom = new SecureRandom();
		StringBuilder sb = new StringBuilder(length);
		for (int i = 0; i < length; i++) {
			sb.append(secureRandom.nextInt(10));
		}
		return sb.toString();
	}




