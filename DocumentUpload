		logger.info("Request : " /* + plainText */);

		String encryptedData = ClientUtility.encryptRawJSON(aesKey, edmsServerPublicKey, plainText);
		logger.info("signedSenderTokenHash : " + finalSignedToken);

		// 6. Step 3: Send Encrypted Data
