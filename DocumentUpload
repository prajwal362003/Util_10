	@PostConstruct
	public void init() throws Exception {
		KeyStore trustStore = KeyStore.getInstance("JKS");
		try(InputStream is = new FileInputStream(props.getKeyStorePath())){
			trustStore.load(is, props.getKeyStorePassword().toCharArray());
		}
		TrustManagerFactory tmf = TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm());
		tmf.init(trustStore);
		SSLContext sslContext = SSLContext.getInstance("TLS");
		sslContext.init(null, tmf.getTrustManagers(), new SecureRandom());
		this.httpClient = HttpClient.newBuilder()
				.sslContext(sslContext)
				.version(HttpClient.Version.HTTP_1_1)
				.build();
	}

	public EDMSResponse callApi(String plainText, String channelId) throws Exception {
		logger.info("<<<<<<<<<<start>>>>>>>>"+props.getPublicKey());

		// 1. Key Generation & Loading
		SecretKey aesKey = ClientUtility.generateAESkey();
		PublicKey edmsServerPublicKey = ClientUtility.getPublicKey(props.getPublicKey());
		
		//logger.info("ckycPrivateKeyPath : " + props.getCkycPrivateKeyPath());

		PrivateKey privateKey = ClientUtility.getKeyFromKeyStore(props.getCkycPrivateKeyPath(), props.getPrivateKeyPassphrase().toCharArray(), null);

		logger.info("<<<<<<<Step 1 Response>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>");

		// 2. Secure Random ID Generation (Replaces RandomStringUtils)
		String randomUniqueId = generateSecureNumericId(16);
		logger.info("random : " + randomUniqueId);
	
		String tokenRequest = "{\"channelID\":\"" + channelId + "\",\"uniqueSourceServerID\":\"" + randomUniqueId + "\"}";
		logger.info("tokenRequest : " + tokenRequest);
		
		String encryptedUniqueSourceServerID = ClientUtility.encryptRawJSON(aesKey, edmsServerPublicKey, tokenRequest);

		// SECURITY WARNING: Do not disable SSL checking in production.
		SSLUtil.turnOfSSLChecking(); 

